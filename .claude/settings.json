{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run map)",
      "Bash(npm run build)",
      "Bash(npm run smoke)",
      "Bash(python3 tools/codemap.py --check)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)"
    ],
    "deny": [
      "Edit(/dist/**)",
      "Write(/dist/**)",
      "Edit(dist/**)",
      "Write(dist/**)"
    ]
  }
}
